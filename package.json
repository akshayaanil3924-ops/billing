{
  "name": "fertilizer-billing",
  "version": "1.0.0",
  "description": "Fertilizer Billing Software",
  "main": "main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "sqlite3": "^5.1.6"
  },
  "build": {
    "appId": "com.idukkigreenagro.billing",
    "productName": "IGA Fertilizer Billing",
    "files": [
      "**/*",
      "!database.sqlite*",
      "!backup*.sqlite",
      "!backups/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
